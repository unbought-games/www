# Copy to .env.local (gitignored); keep secrets out of chat and public/.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Fill these AFTER Terraform creates the R2 state bucket.
# They are R2 S3 credentials, despite the AWS-compatible environment names.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Optional narrower Pages-only token for routine content deployments.
CLOUDFLARE_DEPLOY_TOKEN=

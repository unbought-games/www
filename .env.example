# Copy to .env.local (gitignored); keep secrets out of chat and public/.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# R2 state access uses short-lived credentials derived from the API token.
# No separate permanent R2 access key is required.

# Optional narrower Pages-only token for routine content deployments.
CLOUDFLARE_DEPLOY_TOKEN=
